# Backend environment
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://hackgb:hackgb_dev_password@localhost:5432/hackgb

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=hackgb
MINIO_SECRET_KEY=hackgb_dev_password

# LLM Gateway (Chunk 4)
# Global provider: ollama | openai | anthropic (default: ollama)
LLM_PROVIDER=ollama
# Per-capability overrides (default: same as LLM_PROVIDER)
# LLM_CHAT_PROVIDER=ollama
# LLM_EMBEDDING_PROVIDER=ollama
# Global model overrides (default: per-provider defaults below)
# LLM_CHAT_MODEL=
# LLM_EMBEDDING_MODEL=

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

# Anthropic (cloud, chat only — set LLM_EMBEDDING_PROVIDER for embeddings)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=
