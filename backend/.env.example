# Backend environment template.
#
# Copy to backend/.env and edit:
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored (it holds local values). main.ts loads it
# automatically via dotenv, so a native `node backend/dist/main.js` picks it up
# with no wrapper script. (In Docker, docker-compose injects these instead, so
# the file is a no-op there.)
#
# This template targets running the backend NATIVELY on the SAME machine as a
# local OpenAI-compatible model server (LM Studio / LM Manager / llama.cpp /
# vLLM), where the server is reachable at 127.0.0.1. If your model server is
# elsewhere, change OPENAI_BASE_URL accordingly.

# ---- LLM (local OpenAI-compatible server) ----
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Any non-empty string works for a local server.
OPENAI_API_KEY=lm-studio
# Chat model + embedding model, as advertised by the server (`GET /v1/models`).
OPENAI_CHAT_MODEL=qwen/qwen3.8-27b
OPENAI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ---- Backend port (native) ----
PORT=3001

# ---- Auth (JWT) — CHANGE for anything non-local ----
AUTH_JWT_SECRET=change-me

# ---- Postgres / RustFS (adjust to where they run) ----
# If they run in Docker on this same machine, use the host-published ports.
DATABASE_URL=postgresql://hackgb:hackgb_dev_password@127.0.0.1:5432/hackgb
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=hackgb
MINIO_SECRET_KEY=change-me
