# Keep the Docker build context small. Without this, every build copies the
# entire repo (including multi-GB of node_modules + build output) into the
# build VM — the main reason builds are slow, especially on Windows.

# Dependencies (installed fresh inside the image; the host copies are stale)
node_modules
backend/node_modules
frontend/node_modules

# Build output (recreated by the build stages)
frontend/.next
frontend/out
backend/dist

# VCS + local env + logs
.git
.env
.env.*
!.env.example
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
