# HackGB Curriculum Planning Assistant — environment template
#
# Copy this to `.env` (same directory as docker-compose.yml) and fill in the
# values you want. Every variable has a safe development default in
# docker-compose.yml, so the stack still works out of the box if you skip this.
#
#   cp .env.example .env   # then edit the values below
#
# For anything beyond a local dev box, set strong, unique values for the
# POSTGRES_PASSWORD, RUSTFS_SECRET_KEY, and AUTH_JWT_SECRET entries.

# ---- PostgreSQL ----
POSTGRES_DB=hackgb
POSTGRES_USER=hackgb
# CHANGE THIS for non-local use.
POSTGRES_PASSWORD=hackgb_dev_password
# Optional: set the full connection string instead of the pieces above.
# DATABASE_URL=postgresql://user:password@postgres:5432/hackgb

# ---- RustFS (S3-compatible object storage) ----
RUSTFS_ACCESS_KEY=hackgb
# CHANGE THIS for non-local use.
RUSTFS_SECRET_KEY=hackgb_dev_password

# ---- LLM ----
# The app's backend has an LLM Gateway (chat + embeddings) with three
# providers: ollama, openai (any OpenAI-compatible server), and anthropic.
# Set LLM_PROVIDER to pick one (default: ollama). You can also split
# chat vs embeddings with LLM_CHAT_PROVIDER / LLM_EMBEDDING_PROVIDER.
#
# IMPORTANT — connecting to a model server running on YOUR machine:
#   * Use the special host `local-host` to mean "the machine running the app".
#     Inside the container it resolves to the Docker host (host.docker.internal
#     on Windows/macOS, host-gateway on Linux); running natively it means
#     127.0.0.1. So the same .env works in both setups.
#   * Make sure the server is reachable on that host/port (e.g. Ollama listens
#     on 11434, LM Studio on 1234, llama.cpp server on 8080, vLLM on 8000).
#
# Default (bundled Ollama container in the compose network):
OLLAMA_URL=http://ollama:11434
LLM_PROVIDER=ollama
# OLLAMA_CHAT_MODEL=llama3.2:1b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
#
# To use a model server on YOUR host instead, e.g. your local Ollama:
#   OLLAMA_URL=http://local-host:11434
#   LLM_PROVIDER=ollama
#   OLLAMA_CHAT_MODEL=qwen2.5:7b
#   OLLAMA_EMBEDDING_MODEL=nomic-embed-text
#
# Or any OpenAI-compatible local server (LM Studio / llama.cpp / vLLM /
# Ollama's /v1 endpoint), e.g. LM Studio on port 1234:
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=http://local-host:1234/v1
#   OPENAI_API_KEY=lm-studio            # any non-empty string works locally
#   OPENAI_CHAT_MODEL=llama-3.1-8b      # a model name the server advertises
#   OPENAI_EMBEDDING_MODEL=nomic-embed-text
#
# Optional cloud-provider keys (leave blank to stay fully local/privacy-first):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides (apply to whichever provider is selected):
# LLM_CHAT_MODEL=
# LLM_EMBEDDING_MODEL=

# ---- Model server on ANOTHER machine (e.g. reached over Tailscale) ----
# If your model server is NOT on this machine, just put that machine's
# reachable address in the URL — no special flag needed:
#
#   * Tailscale peer: use its Tailscale IP (`tailscale ip -4` -> 100.x.y.z)
#     or MagicDNS name. The machine running the app must be able to route to
#     that address (e.g. it is itself on the tailnet).
#        OLLAMA_URL=http://100.64.0.5:11434
#        OPENAI_BASE_URL=http://100.64.0.5:1234/v1
#   * Same host: use `local-host` (resolves to the Docker host / 127.0.0.1).
#   * Cloud: the provider's public URL + API key.
#
# (The old TAILOSCALE_INTERFACE / macvlan toggle has been removed — it was
# broken under Docker Desktop/WSL2 and is unnecessary when the backend runs
# natively on the machine that hosts the model server.)

# ---- Auth (JWT) ----
# CHANGE THIS for non-local use. Used to sign login tokens.
AUTH_JWT_SECRET=hackgb-dev-jwt-secret-change-in-prod

# ---- Ports (allocated dynamically by scripts/start.sh) ----
# These are overridden by the start/stop scripts; listed here for reference.
# BACKEND_PORT=3100
# FRONTEND_PORT=3200

# ---- Seed credentials (used by npm run seed-admin / seed-demo) ----
# The admin account the one-time seed creates. Change the password after first
# login for anything non-local.
SEED_ADMIN_EMAIL=admin@school.edu
SEED_ADMIN_PASSWORD=HackGB-Admin-2026
