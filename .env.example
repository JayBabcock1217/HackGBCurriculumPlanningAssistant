# HackGB Curriculum Planning Assistant — environment template
#
# Copy this to `.env` (same directory as docker-compose.yml) and fill in the
# values you want. Every variable has a safe development default in
# docker-compose.yml, so the stack still works out of the box if you skip this.
#
#   cp .env.example .env   # then edit the values below
#
# For anything beyond a local dev box, set strong, unique values for the
# POSTGRES_PASSWORD, RUSTFS_SECRET_KEY, and AUTH_JWT_SECRET entries.

# ---- PostgreSQL ----
POSTGRES_DB=hackgb
POSTGRES_USER=hackgb
# CHANGE THIS for non-local use.
POSTGRES_PASSWORD=hackgb_dev_password
# Optional: set the full connection string instead of the pieces above.
# DATABASE_URL=postgresql://user:password@postgres:5432/hackgb

# ---- RustFS (S3-compatible object storage) ----
RUSTFS_ACCESS_KEY=hackgb
# CHANGE THIS for non-local use.
RUSTFS_SECRET_KEY=hackgb_dev_password

# ---- LLM ----
# Ollama lives in the compose network by default.
OLLAMA_URL=http://ollama:11434
# Optional cloud-provider keys (leave blank to stay fully local/privacy-first):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides:
# LLM_CHAT_MODEL=
# LLM_EMBEDDING_MODEL=

# ---- Auth (JWT) ----
# CHANGE THIS for non-local use. Used to sign login tokens.
AUTH_JWT_SECRET=hackgb-dev-jwt-secret-change-in-prod

# ---- Ports (allocated dynamically by scripts/start.sh) ----
# These are overridden by the start/stop scripts; listed here for reference.
# BACKEND_PORT=3100
# FRONTEND_PORT=3200

# ---- Seed credentials (used by npm run seed-admin / seed-demo) ----
# The admin account the one-time seed creates. Change the password after first
# login for anything non-local.
SEED_ADMIN_EMAIL=admin@school.edu
SEED_ADMIN_PASSWORD=HackGB-Admin-2026
